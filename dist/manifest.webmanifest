{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "Diário da Fé Digital",
  "short_name": "Diário da Fé",
  "description": "Diário da Fé Digital — em outubro, devocionais especiais para mulheres, com fé, cuidado e fortalecimento da alma.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#7e2e4b",
  "theme_color": "#c95f86",
  "lang": "pt-BR",
  "icons": [
    {
      "src": "./icons/icon-outubro-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-outubro-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-outubro-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
